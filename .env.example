VITE_MAPBOX_TOKEN=pk.your_mapbox_public_token_here

# ── Copernicus Data Space Ecosystem — STAC / DEM (server) ───────
CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1
CDSE_DEM_COLLECTION=cop-dem-glo-30-dged-cog
CDSE_COVERAGE_BBOX=103.45,1.10,104.25,1.65
CDSE_POLL_INTERVAL_MS=3600000
CDSE_HISTORY_RETENTION_DAYS=90
SENTINEL_DATA_DIR=./data

# ── Copernicus Data Space Ecosystem — S3 (server only) ──────────
# S3 credentials from https://eodata-s3keysmanager.dataspace.copernicus.eu/
# Do NOT prefix with VITE_ — these must never reach the browser.
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
CDSE_S3_ENDPOINT=https://eodata.dataspace.copernicus.eu
CDSE_S3_BUCKET=eodata

# ── Offline map (optional) ─────────────────────────────────────
# Force local tiles — no Mapbox cloud required when tiles are in public/offline/
# VITE_OFFLINE_MODE=true

# Override basemap style JSON (served from public/)
# VITE_MAP_STYLE_URL=/offline/styles/sentinel-ops.json

# Self-hosted DEM Terrain-RGB tiles (Singapore AO)
# VITE_DEM_TILES_URL=/offline/tiles/dem/{z}/{x}/{y}.png
# VITE_DEM_ENCODING=mapbox

# Optional raster / vector / contour tiles
# VITE_SATELLITE_TILES_URL=/offline/tiles/satellite/{z}/{x}/{y}.png
# VITE_VECTOR_TILES_URL=/offline/tiles/vector/{z}/{x}/{y}.pbf
# VITE_CONTOUR_TILES_URL=/api/offline/pmtiles/contours/{z}/{x}/{y}.pbf
