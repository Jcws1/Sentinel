# Base URL for the self-hosted basemap bundle (tiles, glyphs, sprite).
# Leave unset to use the offline void basemap. On an edge node this points
# at the local tile server, e.g. http://127.0.0.1:8080/data/v3
VITE_BASEMAP_URL=

# Which style to boot with: "dark" (needs VITE_BASEMAP_URL) or "void".
# Unset = auto: dark if VITE_BASEMAP_URL is set, otherwise void.
VITE_BASEMAP_STYLE=

# Map source pack: edge (local PMTiles, offline, Singapore only) | global
# (OpenFreeMap + AWS terrain, needs network) | void. Defaults to edge.
VITE_MAP_PACK=

# --- Terrain / 3D -----------------------------------------------------------
# Local Mapterhorn extract, e.g. pmtiles:///edge-map/data/seasia-terrain.pmtiles
# Set this and the free global-3D pack flips from streaming to fully offline.
#   pmtiles extract https://download.mapterhorn.com/planet.pmtiles \
#     seasia-terrain.pmtiles --bbox=99.0,-1.5,105.5,7.0
VITE_TERRAIN_PMTILES=

# Google Maps Platform key for the God's Eye photoreal pack. CLIENT-EXPOSED.
# Enable the "Map Tiles API", restrict the key by HTTP referrer, and SET A
# BILLING BUDGET before first use — photoreal tiles bill per request and an
# orbiting camera streams continuously.
VITE_GOOGLE_MAPS_API_KEY=

# Cesium ion token. FALLBACK ROUTE ONLY — ion brokers the *same* Google
# tileset (asset 2275207); its /endpoint response hands back a
# tile.googleapis.com URL. It is not a different or better dataset. The only
# runtime difference is whose quota burns: direct spends your Google billing,
# ion spends your ion allowance.
# NOTE: ion's free Community tier is personal/non-commercial only.
VITE_CESIUM_ION_TOKEN=
