{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd frontend && npm ci",
  "buildCommand": "cd frontend && npm run build",
  "outputDirectory": "frontend/dist",
  "redirects": [
    {
      "source": "/(.*)",
      "destination": "https://sentinel-v3-api.onrender.com/$1",
      "permanent": false
    }
  ]
}
