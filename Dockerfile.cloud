FROM node:22-bookworm-slim AS frontend-build

WORKDIR /build/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend /build/frontend
COPY contracts /build/contracts
ARG VITE_TACTICAL_PROVIDER=maptiler
ARG VITE_TACTICAL_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
ARG VITE_MAPTILER_KEY
ARG VITE_CESIUM_ION_TOKEN
ARG VITE_CESIUM_IMAGERY_ASSET_ID
ARG VITE_CESIUM_TERRAIN_ASSET_ID
ARG VITE_CESIUM_BUILDINGS_ASSET_ID
ARG VITE_GOOGLE_MAPS_API_KEY
ARG VITE_CESIUM_PHOTOREALISTIC_ASSET_ID=0
ENV VITE_TACTICAL_PROVIDER=$VITE_TACTICAL_PROVIDER \
    VITE_TACTICAL_STYLE_URL=$VITE_TACTICAL_STYLE_URL \
    VITE_MAPTILER_KEY=$VITE_MAPTILER_KEY \
    VITE_CESIUM_ION_TOKEN=$VITE_CESIUM_ION_TOKEN \
    VITE_CESIUM_IMAGERY_ASSET_ID=$VITE_CESIUM_IMAGERY_ASSET_ID \
    VITE_CESIUM_TERRAIN_ASSET_ID=$VITE_CESIUM_TERRAIN_ASSET_ID \
    VITE_CESIUM_BUILDINGS_ASSET_ID=$VITE_CESIUM_BUILDINGS_ASSET_ID \
    VITE_GOOGLE_MAPS_API_KEY=$VITE_GOOGLE_MAPS_API_KEY \
    VITE_CESIUM_PHOTOREALISTIC_ASSET_ID=$VITE_CESIUM_PHOTOREALISTIC_ASSET_ID
RUN npm run build

FROM python:3.12-slim

WORKDIR /app

COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

COPY backend/app /app/backend/app
COPY contracts /app/contracts
COPY backend/hosting.py /app/backend/hosting.py
COPY --from=frontend-build /build/frontend/dist /app/frontend/dist

ENV PYTHONPATH=/app/backend
EXPOSE 10000

CMD ["sh", "-c", "uvicorn hosting:app --host 0.0.0.0 --port ${PORT:-10000}"]
