{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sentinel.invalid/contracts/behavior-assessment/v1/request.schema.json",
  "title": "Immutable behavior assessment request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "feature_contract_version", "request_id", "mission_id",
    "mission_epoch", "track_id", "track_revision", "captured_at", "expires_at",
    "history", "assets"
  ],
  "properties": {
    "contract_version": {"const": "sentinel.behavior-assessment/v1"},
    "feature_contract_version": {"const": "sentinel.behavior-features/v1"},
    "request_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "mission_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "mission_epoch": {"type": "string", "minLength": 1, "maxLength": 128},
    "track_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "track_revision": {"type": "integer", "minimum": 0},
    "captured_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "history": {
      "type": "array", "minItems": 1, "maxItems": 120,
      "items": {"$ref": "#/$defs/observation"}
    },
    "assets": {
      "type": "array", "maxItems": 64,
      "items": {"$ref": "#/$defs/asset"}
    }
  },
  "$defs": {
    "observation": {
      "type": "object", "additionalProperties": false,
      "required": [
        "timestamp_s", "x_m", "y_m", "z_m", "vx_mps", "vy_mps", "vz_mps",
        "speed_mps", "heading_deg", "track_confidence", "identity_confidence",
        "sensor_age_s"
      ],
      "properties": {
        "timestamp_s": {"type": "number"}, "x_m": {"type": "number"},
        "y_m": {"type": "number"}, "z_m": {"type": "number"},
        "vx_mps": {"type": "number"}, "vy_mps": {"type": "number"},
        "vz_mps": {"type": "number"}, "speed_mps": {"type": "number", "minimum": 0},
        "heading_deg": {"type": "number"},
        "track_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "identity_confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "sensor_age_s": {"type": "number", "minimum": 0}
      }
    },
    "asset": {
      "type": "object", "additionalProperties": false,
      "required": ["asset_id", "x_m", "y_m", "protected_radius_m", "monitoring_radius_m"],
      "properties": {
        "asset_id": {"type": "string", "minLength": 1, "maxLength": 128},
        "x_m": {"type": "number"}, "y_m": {"type": "number"},
        "protected_radius_m": {"type": "number", "minimum": 0},
        "monitoring_radius_m": {"type": "number", "minimum": 0}
      }
    }
  }
}

