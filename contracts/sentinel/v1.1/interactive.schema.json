      "type": "object"
    },
    "CreateRunRequest": {
      "additionalProperties": false,
      "properties": {
        "creationId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Creationid",
          "type": "string"
        },
        "templateId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Templateid",
          "type": "string"
        }
      },
      "required": [
        "creationId",
        "templateId"
      ],
      "title": "CreateRunRequest",
      "type": "object"
    },
    "DemoEntry": {
      "additionalProperties": false,
      "properties": {
        "activeMissionId": {
          "anyOf": [
            {
              "maxLength": 256,
              "minLength": 1,
              "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Activemissionid"
