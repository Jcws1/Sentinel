  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Export root; no route accepts this aggregate.",
  "properties": {
    "command": {
      "$ref": "#/$defs/CommandRequest"
    },
    "creation": {
      "$ref": "#/$defs/CreateRunRequest"
    },
    "entry": {
      "$ref": "#/$defs/DemoEntry"
    },
    "intent": {
      "$ref": "#/$defs/Intent"
    },
    "receipt": {
