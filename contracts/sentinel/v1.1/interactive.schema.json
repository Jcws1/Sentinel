        "holderId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Holderid",
          "type": "string"
        },
        "intent": {
          "$ref": "#/$defs/Intent"
        }
