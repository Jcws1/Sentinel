        "bindingRevision": {
          "maximum": 9007199254740991,
          "minimum": 0,
          "title": "Bindingrevision",
          "type": "integer"
        },
        "capabilities": {
          "items": {
            "const": "move-horizontal",
            "type": "string"
          },
          "title": "Capabilities",
          "type": "array"
