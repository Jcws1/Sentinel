        "eligible": {
          "const": false,
          "default": false,
          "title": "Eligible",
          "type": "boolean"
        },
        "entityId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Entityid",
          "type": "string"
        },
        "executorId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Executorid",
          "type": "string"
        },
        "grantId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Grantid",
          "type": "string"
        },
        "missionId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Missionid",
          "type": "string"
        },
        "positionReference": {
          "const": "ELLIPSOID/WGS84",
          "title": "Positionreference",
          "type": "string"
        },
        "reason": {
          "title": "Reason",
          "type": "string"
        },
        "sourceId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
          "title": "Sourceid",
          "type": "string"
        }
      },
      "required": [
        "missionId",
        "assetId",
        "entityId",
        "executorId",
        "sourceId",
        "grantId",
        "bindingRevision",
        "capabilities",
        "positionReference",
        "reason"
      ],
      "title": "AssetControl",
      "type": "object"
    },
    "CommandRequest": {
      "additionalProperties": false,
      "properties": {
        "commandId": {
          "maxLength": 256,
          "minLength": 1,
          "pattern": "^[^\\s\\x00-\\x1f\\x7f](?:[^\\x00-\\x1f\\x7f]*[^\\s\\x00-\\x1f\\x7f])?$",
