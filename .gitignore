# Installed dependencies and local Python environments.
node_modules/
.venv/
venv/

# Generated bundles, including every named frontend test/review build.
dist/
/frontend/dist-*/
/backend/build/
*.egg-info/

# Tool caches and incremental compilation.
.cache/
/target/
**/target/
.vite/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.eslintcache
*.tsbuildinfo

# Generated test results, reports and coverage.
test-results/
playwright-report/
blob-report/
coverage/
htmlcov/
.nyc_output/
.coverage
.coverage.*
# Historical browser reporters once wrote here; keep machine results out of source.
/frontend/docs/**/browser-results.json

# Local credentials/configuration; keep example/template files shareable.
.env
.env.*
!.env.example
!.env.*.example
!.env.template
!.env.*.template
.vercel/

# Reproducible environmental pack; ~1.05 GB, never ordinary source control.
/frontend/public/edge-map/

# Local operator/test databases and SQLite sidecars.
/backend/data/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
*.sqlite3-journal

# Documentation, reusable test inputs and licence notices are source files.
# Raw runs belong in test-results/; local historical evidence is archived outside
# the checkout. Keep these generic scratch destinations out of future commits.
/output/
/tmp/
*.prof
*.cpuprofile
/research-brain

# Generated logs and operating-system metadata.
*.log
.DS_Store
Thumbs.db
Desktop.ini
desktop.ini
