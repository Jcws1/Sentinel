{
  "name": "sentinel-v3-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "dev": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:verification": "vite build --mode verification",
    "build:test": "node scripts/build-test-bundles.mjs",
    "maps:setup": "node scripts/setup-local-maps.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 5181 --strictPort",
    "preview:verification": "vite preview --mode verification --host 127.0.0.1 --port 5182 --strictPort",
    "test": "vitest run",
    "test:browser": "node tests/support/run-browser.mjs",
    "lint": "eslint src tests --max-warnings 0",
    "format:check": "prettier --check src tests *.ts *.json *.html",
    "contracts:foundation:check": "node scripts/generate-foundation-contracts.mjs --check",
    "build:performance": "node scripts/build-performance.mjs",
    "test:performance": "node tests/performance/measure.mjs",
    "test:capacity": "node tests/performance/recovery.mjs",
    "test:geometry": "node tests/performance/geometry.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@tanstack/react-table": "8.21.3",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "cesium": "1.145.0",
    "flexlayout-react": "0.10.8",
    "lucide-react": "1.44.0",
    "maplibre-gl": "6.9.0",
    "pmtiles": "4.5.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "jsdom": "30.0.1",
    "json-schema-to-typescript": "16.0.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
