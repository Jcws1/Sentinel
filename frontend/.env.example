# Copy to .env.local. Browser tokens are public client credentials, not server secrets.
# Restrict them to local/demo origins and read-only map assets. Never commit .env.local.
VITE_TACTICAL_STYLE_URL=https://api.maptiler.com/maps/streets-v4/style.json
# local = regional PMTiles pack (see docs/MAP_REFINEMENT_SETUP.md); maptiler = hosted.
VITE_TACTICAL_PROVIDER=local
VITE_MAPTILER_KEY=

VITE_CESIUM_ION_TOKEN=
# Public ion assets: Bing Aerial, World Terrain, OSM Buildings. 0 disables a layer.
VITE_CESIUM_IMAGERY_ASSET_ID=2
VITE_CESIUM_TERRAIN_ASSET_ID=1
VITE_CESIUM_BUILDINGS_ASSET_ID=96188

# Existing Google Cloud project: Map Tiles API must already be enabled with billing.
# Browser website-referrer restriction + API restriction to Map Tiles API.
VITE_GOOGLE_MAPS_API_KEY=
# Standard remains the initial base. Choose Google in the 3D Layers menu.
# Optional ion alternative: enable asset 2275207 yourself, then replace 0 here.
VITE_CESIUM_PHOTOREALISTIC_ASSET_ID=0
